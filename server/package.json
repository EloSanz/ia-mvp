{
  "name": "api",
  "type": "module",
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "forceExit": true,
    "detectOpenHandles": true,
    "testTimeout": 10000
  },
  "scripts": {
    "dev": "npx prisma generate && nodemon src/index.js",
    "db:sync": "npx prisma db push && npx prisma generate",
    "start": "node src/index.js",
    "dockerStart": "npx prisma db push && npx prisma generate && node src/index.js",
    "db:reset": "echo '🛑 ATENCIÓN: Esto BORRARÁ TODOS LOS DATOS' && sleep 3 && pm2 stop ia-mvp 2>/dev/null || echo 'App not running' && npx prisma migrate reset --force --skip-generate 2>/dev/null || npx prisma db push --force-reset && npx prisma generate && npx prisma db seed 2>/dev/null || echo 'No seed' && pm2 restart ia-mvp 2>/dev/null || npm start",
    "db:nuke": "echo '💥 NUCLEAR OPTION: Drop and recreate database' && sleep 3 && pm2 stop ia-mvp 2>/dev/null || echo 'App stopped' && sudo -u postgres psql -c 'DROP DATABASE IF EXISTS ia_flashcards;' -c 'CREATE DATABASE ia_flashcards;' && npx prisma db push && npx prisma generate && pm2 restart ia-mvp 2>/dev/null || npm start",
    "db:push": "npx prisma db push",
    "db:status": "npx prisma migrate status",
    "db:generate": "npx prisma generate",
    "test": "jest",
    "test:e2e": "./test-integration.sh",
    "test:unit": "jest --testMatch=\"**/unit/**/*.test.js\" --testMatch=\"**/src/**/*.test.js\"",
    "test:integration": "jest --testMatch=\"**/integration/**/*.test.js\"",
    "test:all": "jest --testPathIgnorePatterns=\"\" --testMatch=\"**/*.test.js\"",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.19.2",
    "express-validator": "^7.2.1",
    "file-type": "^18.0.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "multer": "1.4.5-lts.1",
    "openai": "^5.19.1",
    "pdf-parse": "^1.1.1",
    "sanitize-filename": "^1.6.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "prisma": "^6.19.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "babel-jest": "^30.1.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.1.3",
    "nodemon": "^3.1.0",
    "prettier": "^3.6.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
