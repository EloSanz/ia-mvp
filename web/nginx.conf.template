# Nginx configuration template for SPA + API proxy
# Replace ${VITE_API_URL} at container start using envsubst
server {
  listen 5173;
  server_name _;

  # Serve static files
  root /usr/share/nginx/html;
  index index.html;

  # Try files for SPA routing
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Proxy API requests to backend (set VITE_API_URL env var to e.g. http://backend:3000)
  location /api/ {
    proxy_pass ${VITE_API_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
  }

  # Optional: serve compressed files if present
  gzip on;
  gzip_types text/plain application/javascript application/json text/css application/xml;
}
